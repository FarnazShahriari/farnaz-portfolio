# The design system lives on GitHub Packages, not the public npm registry,
# so the @farnazshahriari scope has to be pointed there explicitly.
@farnazshahriari:registry=https://npm.pkg.github.com

# Auth comes from the environment — never commit a token. Set NODE_AUTH_TOKEN
# to a GitHub personal access token with `read:packages`:
#   locally  : export NODE_AUTH_TOKEN=ghp_...   (or put it in ~/.npmrc)
#   on Vercel: Project Settings -> Environment Variables -> NODE_AUTH_TOKEN
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
